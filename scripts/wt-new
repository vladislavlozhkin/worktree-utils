#!/bin/bash

# ==============================================================================
# wt-new: Create a new worktree (branch + folder + setup).
# Usage: wt-new <branch-name> [base-branch]
#
# Honours the WT_BASE_DIR env variable (also read from .env / .env.local
# in the main worktree) to override the default placement of the new folder.
# ==============================================================================

__src="${BASH_SOURCE[0]}"
while [ -L "$__src" ]; do
  __dir=$(cd -P "$(dirname "$__src")" && pwd)
  __src=$(readlink "$__src")
  [[ "$__src" != /* ]] && __src="$__dir/$__src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$__src")" && pwd)"
unset __src __dir
# shellcheck source-path=SCRIPTDIR source=wt-lib.sh
. "$SCRIPT_DIR/wt-lib.sh"

BRANCH_NAME=$1
BASE_BRANCH=${2:-HEAD}

if [ -z "$BRANCH_NAME" ]; then
  echo "Использование: wt-new <branch-name> [base-branch]"
  echo "Пример: wt-new feature/user-auth"
  exit 1
fi

# Make sure we are inside a git repository.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "❌ Текущая папка не является git-репозиторием."
  exit 1
fi

# Validate the branch name through git itself — rejects '..', spaces, etc.
if ! git check-ref-format --branch "$BRANCH_NAME" >/dev/null 2>&1; then
  echo "❌ Недопустимое имя ветки: '$BRANCH_NAME'"
  echo "   Имя должно соответствовать правилам git (см. git-check-ref-format)."
  exit 1
fi

# Decide whether the branch already exists (we'll attach to it) or not (we'll
# create it via `-b`). If it does exist, also figure out whether some other
# worktree currently holds it.
BRANCH_EXISTS=false
EXISTING_WT_PATH=""
if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
  BRANCH_EXISTS=true
  EXISTING_WT_PATH=$(git worktree list --porcelain | awk -v b="branch refs/heads/$BRANCH_NAME" '
    /^worktree /{ p = substr($0, 10) }
    $0 == b      { print p; exit }
  ')

  if [ -n "$EXISTING_WT_PATH" ] && [ -d "$EXISTING_WT_PATH" ]; then
    echo "❌ Ветка '$BRANCH_NAME' уже подключена к worktree: $EXISTING_WT_PATH"
    exit 1
  fi

  if [ -n "$EXISTING_WT_PATH" ]; then
    # Stale registration: the folder is gone, the metadata is not.
    echo "⚠️  Папка $EXISTING_WT_PATH удалена вручную. Чищу stale-запись..."
    git worktree prune
  fi
fi

# Folder name from branch name: feature/login -> feature-login.
DIR_NAME=${BRANCH_NAME//\//-}

# Resolve target directory.
MAIN_WT=$(wt_main_worktree)
wt_load_env_vars "$MAIN_WT"

if [ -n "$WT_BASE_DIR" ]; then
  # Expand ~ if present (user-controlled value).
  EXPANDED_BASE="${WT_BASE_DIR/#\~/$HOME}"
  TARGET_DIR="$EXPANDED_BASE/$DIR_NAME"
else
  TARGET_DIR="../$DIR_NAME"
fi

if [ -e "$TARGET_DIR" ]; then
  echo "❌ Ошибка: Путь $TARGET_DIR уже существует."
  exit 1
fi

# Make sure the parent directory exists when WT_BASE_DIR is set.
PARENT_DIR=$(dirname "$TARGET_DIR")
if [ ! -d "$PARENT_DIR" ]; then
  mkdir -p "$PARENT_DIR" || { echo "❌ Не удалось создать $PARENT_DIR"; exit 1; }
fi

echo "🚀 Создаём worktree..."
echo "   Ветка: $BRANCH_NAME"
echo "   Папка: $TARGET_DIR"
if [ "$BRANCH_EXISTS" = true ]; then
  echo "   Режим: переподключение к существующей ветке"
  if ! git worktree add "$TARGET_DIR" "$BRANCH_NAME"; then
    echo "❌ Ошибка при создании worktree."
    exit 1
  fi
else
  echo "   База:  $BASE_BRANCH"
  if ! git worktree add -b "$BRANCH_NAME" "$TARGET_DIR" "$BASE_BRANCH"; then
    echo "❌ Ошибка при создании worktree."
    exit 1
  fi
fi

# Run wt-setup inside the new directory. Look next to ourselves so that
# global installs (~/bin/wt -> .../scripts/wt) keep working — there is no
# scripts/ folder inside the user's repo in that mode.
SETUP_SCRIPT="$SCRIPT_DIR/wt-setup"
if [ -x "$SETUP_SCRIPT" ]; then
  echo "🔗 Запускаем wt-setup..."
  (cd "$TARGET_DIR" && "$SETUP_SCRIPT")
else
  echo "⚠️  Скрипт wt-setup не найден по пути: $SETUP_SCRIPT"
  echo "   Окружение придётся настроить вручную."
fi

echo ""
echo "✅ Готово! Для начала работы:"
echo "   cd $TARGET_DIR"
