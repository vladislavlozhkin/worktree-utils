#!/bin/bash

# ==============================================================================
# wt-setup: Synchronise files from the main worktree into the current one.
#
# Reads two sources (in order; first wins per file):
#   1. .worktree-config in the main worktree (LINK / COPY / RUN).
#   2. .git/info/exclude (treated as LINK).
#
# Config syntax: "[VERB] PATH"  — first whitespace splits VERB and the rest.
# A line without a known VERB is treated as "LINK PATH".
# Lines starting with '#' or empty are ignored.
#
# WARNING: `RUN` lines are evaluated in the shell. The .worktree-config file
# is configuration with the same trust level as a Makefile — never source one
# from an untrusted repository.
# ==============================================================================

SCRIPT_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR source=wt-lib.sh
. "$SCRIPT_DIR/wt-lib.sh"

MAIN_WORKTREE=$(wt_main_worktree)
if [ -z "$MAIN_WORKTREE" ]; then
  echo "❌ Ошибка: Не удалось определить Main Worktree."
  exit 1
fi

# Resolve physical roots before parsing config or performing any operations.
WORKTREE_ROOT=$(git rev-parse --show-toplevel) || exit 1
WORKTREE_ROOT=$(cd "$WORKTREE_ROOT" && pwd -P) || exit 1
MAIN_WORKTREE=$(cd "$MAIN_WORKTREE" && pwd -P) || exit 1
if [ "$WORKTREE_ROOT" = "$MAIN_WORKTREE" ]; then
  echo "❌ wt setup разрешён только в linked worktree, не в main." >&2
  exit 1
fi
cd "$WORKTREE_ROOT" || exit 1

echo "🔍 Main Worktree: $MAIN_WORKTREE"

GIT_COMMON_DIR=$(git rev-parse --git-common-dir) || exit 1
EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
CONFIG_FILE="$MAIN_WORKTREE/.worktree-config"

# Tasks are stored as TAB-separated "ACTION<TAB>SOURCE<TAB>ARG" so paths can
# hold spaces. SOURCE is "config" (from .worktree-config) or "exclude"
# (from .git/info/exclude) — config entries are explicit user intent and may
# overwrite tracked files; exclude entries are conservative and never do.
TASKS=()
SEEN_PATHS=()

# Add a task while deduplicating LINK/COPY entries (first wins).
add_task() {
  local action="$1" source="$2" arg="$3"

  if [ "$action" != "RUN" ]; then
    # Normalize directory suffixes for both sources, and Git's root anchor
    # only for exclude entries. Deduplicate normalized paths (first wins).
    [ "$source" = "exclude" ] && arg="${arg#/}"
    while [[ "$arg" == */ ]]; do arg="${arg%/}"; done
    while [[ "$arg" == ./* ]]; do arg="${arg#./}"; done
    case "/$arg/" in
      *'//'*|*'/../'*|*'/./'*|*'/.git/'*)
        if [ "$source" = "exclude" ]; then
          echo "⚠️  Пропущено exclude: $arg (небезопасный или неподдерживаемый путь)" >&2
          return 0
        fi
        echo "❌ Небезопасный путь: $arg" >&2
        exit 1 ;;
    esac
    if [ "$source" = "exclude" ]; then
      case "$arg" in
        '!'*|*\\*)
          echo "⚠️  Пропущено exclude: $arg (неподдерживаемый паттерн)" >&2
          return 0 ;;
      esac
    fi
    local seen
    for seen in "${SEEN_PATHS[@]}"; do
      [ "$seen" = "$arg" ] && return 0
    done
    SEEN_PATHS+=("$arg")
  fi
  TASKS+=("$action"$'\t'"$source"$'\t'"$arg")
}

# Parse .worktree-config. Splits on the FIRST run of whitespace only,
# so RUN commands and paths with spaces survive intact.
parse_config_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  echo "📄 Читаем config:  $file"

  local raw verb rest
  while IFS= read -r raw || [ -n "$raw" ]; do
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    [[ -z "$raw" ]] && continue
    [[ "$raw" == \#* ]] && continue

    if [[ "$raw" =~ ^([A-Za-z]+)[[:space:]]+(.+)$ ]]; then
      # Bash 3.2 (macOS) has no ${value^^} expansion.
      verb=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
      rest="${BASH_REMATCH[2]}"
      case "$verb" in
        LINK|COPY|RUN) add_task "$verb" "config" "$rest" ;;
        *) add_task "LINK" "config" "$raw" ;;  # Verb wasn't recognised; treat the whole line as a path.
      esac
    else
      add_task "LINK" "config" "$raw"
    fi
  done < "$file"
}

# Parse .git/info/exclude — every non-comment, non-blank line is a LINK target.
parse_exclude_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  echo "📄 Читаем exclude: $file"

  local raw
  while IFS= read -r raw || [ -n "$raw" ]; do
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    [[ -z "$raw" ]] && continue
    [[ "$raw" == \#* ]] && continue
    add_task "LINK" "exclude" "$raw"
  done < "$file"
}

parse_config_file "$CONFIG_FILE"
parse_exclude_file "$EXCLUDE_FILE"

echo "⚙️  Настройка окружения..."

for TASK in "${TASKS[@]}"; do
  ACTION="${TASK%%$'\t'*}"
  REST="${TASK#*$'\t'}"
  TASK_SOURCE="${REST%%$'\t'*}"
  ITEM="${REST#*$'\t'}"

  if [ "$ACTION" = "RUN" ]; then
    echo "🚀 RUN: $ITEM"
    # Each RUN starts at the root; cd/exit cannot change the setup process.
    (eval "$ITEM")
    RUN_STATUS=$?
    if [ "$RUN_STATUS" -ne 0 ]; then
      echo "❌ RUN завершился с ошибкой ($RUN_STATUS): $ITEM" >&2
      exit "$RUN_STATUS"
    fi
    continue
  fi

  if [[ "$ITEM" == *"*"* ]] || [[ "$ITEM" == *"?"* ]] || [[ "$ITEM" == *"["* ]]; then
    echo "⚪️ Пропущено: $ITEM (glob-паттерны не поддерживаются)"
    continue
  fi

  SRC="$MAIN_WORKTREE/$ITEM"
  TGT="./$ITEM"

  # Never traverse a destination directory symlink (including dangling ones).
  PARENT=$(dirname "$TGT") || exit 1
  SKIP_ITEM=false
  while [ "$PARENT" != "." ]; do
    if [ -L "./$PARENT" ]; then
      if [ "$TASK_SOURCE" = "exclude" ]; then
        echo "⚠️  Пропущено exclude: $ITEM (родитель — симлинк: $PARENT)" >&2
        SKIP_ITEM=true
        break
      fi
      echo "❌ Родитель пути — симлинк: $PARENT" >&2
      exit 1
    fi
    PARENT=$(dirname "$PARENT") || exit 1
  done
  [ "$SKIP_ITEM" = true ] && continue

  if [ ! -e "$SRC" ] && [ ! -L "$SRC" ]; then
    continue
  fi

  if [ -e "$TGT" ] || [ -L "$TGT" ]; then
    STATUS=$(git --literal-pathspecs status --porcelain --untracked-files=all --ignored -- "$ITEM") || exit 1
    # Status can hide edits under index flags, and does not inventory data in
    # submodules. Refuse replacement whenever either limitation applies.
    INDEX_FLAGS=$(git --literal-pathspecs ls-files -v -- "$ITEM") || exit 1
    INDEX_STAGES=$(git --literal-pathspecs ls-files --stage -- "$ITEM") || exit 1
    PROTECTED=false
    while IFS= read -r ENTRY; do
      case "$ENTRY" in [a-zS]' '*) PROTECTED=true ;; esac
    done <<< "$INDEX_FLAGS"
    while IFS= read -r ENTRY; do
      case "$ENTRY" in '160000 '*) PROTECTED=true ;; esac
    done <<< "$INDEX_STAGES"
    if [ "$PROTECTED" = false ] && [ -d "$TGT" ] && [ ! -L "$TGT" ]; then
      # Nested .git files/dirs may themselves be ignored or untracked.
      # Also recognize bare repositories by HEAD + objects. find does not
      # follow directory symlinks, and need not inventory .git contents.
      NESTED_GIT=$(find "$TGT" -name .git -prune -print -o -name HEAD -type f -print) || exit 1
      while IFS= read -r METADATA; do
        case "$METADATA" in
          */.git) PROTECTED=true ;;
          */HEAD) [ -d "${METADATA%/*}/objects" ] && PROTECTED=true ;;
        esac
      done <<< "$NESTED_GIT"
    fi
    if [ ! -L "$TGT" ] && [ "$TASK_SOURCE" = "config" ] \
         && [ "$PROTECTED" = false ] \
         && git --literal-pathspecs ls-files --error-unmatch -- "$ITEM" >/dev/null 2>&1 \
         && [ -z "$STATUS" ]; then
      # Include ignored contents: ordinary git status hides local data inside
      # tracked directories. Existing symlinks are always preserved.
      rm -r -- "$TGT" || exit 1
    else
      echo "⚠️  Пропущено: $ITEM (существующий или защищённый путь, не перезаписываю)"
      continue
    fi
  fi

  TGT_PARENT=$(dirname "$TGT")
  if [ ! -d "$TGT_PARENT" ]; then
    mkdir -p "$TGT_PARENT" || exit 1
  fi

  if [ "$ACTION" = "COPY" ]; then
    cp -RP "$SRC" "$TGT" || exit 1
    echo "📋 COPY: $ITEM"
  elif [ "$ACTION" = "LINK" ]; then
    ln -s "$SRC" "$TGT" || exit 1
    echo "🔗 LINK: $ITEM"
  else
    echo "❓ Неизвестное действие: $ACTION для $ITEM" >&2
    exit 1
  fi
done

echo "🎉 Готово!"
