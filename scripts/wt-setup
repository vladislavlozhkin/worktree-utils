#!/bin/bash

# ==============================================================================
# wt-setup: Synchronise files from the main worktree into the current one.
#
# Reads two sources (in order; first wins per file):
#   1. .worktree-config in the main worktree (LINK / COPY / RUN).
#   2. .git/info/exclude (treated as LINK).
#
# Config syntax: "[VERB] PATH"  — first whitespace splits VERB and the rest.
# A line without a known VERB is treated as "LINK PATH".
# Lines starting with '#' or empty are ignored.
#
# WARNING: `RUN` lines are evaluated in the shell. The .worktree-config file
# is configuration with the same trust level as a Makefile — never source one
# from an untrusted repository.
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source-path=SCRIPTDIR source=wt-lib.sh
. "$SCRIPT_DIR/wt-lib.sh"

MAIN_WORKTREE=$(wt_main_worktree)
if [ -z "$MAIN_WORKTREE" ]; then
  echo "❌ Ошибка: Не удалось определить Main Worktree."
  exit 1
fi

echo "🔍 Main Worktree: $MAIN_WORKTREE"

GIT_COMMON_DIR=$(git rev-parse --git-common-dir)
EXCLUDE_FILE="$GIT_COMMON_DIR/info/exclude"
CONFIG_FILE="$MAIN_WORKTREE/.worktree-config"

# Tasks are stored as TAB-separated "ACTION<TAB>SOURCE<TAB>ARG" so paths can
# hold spaces. SOURCE is "config" (from .worktree-config) or "exclude"
# (from .git/info/exclude) — config entries are explicit user intent and may
# overwrite tracked files; exclude entries are conservative and never do.
TASKS=()
SEEN_PATHS=()

# Add a task while deduplicating LINK/COPY entries (first wins).
add_task() {
  local action="$1" source="$2" arg="$3"

  if [ "$action" != "RUN" ]; then
    local seen
    for seen in "${SEEN_PATHS[@]}"; do
      [ "$seen" = "$arg" ] && return 0
    done
    SEEN_PATHS+=("$arg")
  fi
  TASKS+=("$action"$'\t'"$source"$'\t'"$arg")
}

# Parse .worktree-config. Splits on the FIRST run of whitespace only,
# so RUN commands and paths with spaces survive intact.
parse_config_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  echo "📄 Читаем config:  $file"

  local raw verb rest
  while IFS= read -r raw || [ -n "$raw" ]; do
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    [[ -z "$raw" ]] && continue
    [[ "$raw" == \#* ]] && continue

    if [[ "$raw" =~ ^([A-Za-z]+)[[:space:]]+(.+)$ ]]; then
      verb="${BASH_REMATCH[1]^^}"
      rest="${BASH_REMATCH[2]}"
      case "$verb" in
        LINK|COPY|RUN) add_task "$verb" "config" "$rest" ;;
        *) add_task "LINK" "config" "$raw" ;;  # Verb wasn't recognised; treat the whole line as a path.
      esac
    else
      add_task "LINK" "config" "$raw"
    fi
  done < "$file"
}

# Parse .git/info/exclude — every non-comment, non-blank line is a LINK target.
parse_exclude_file() {
  local file="$1"
  [ -f "$file" ] || return 0

  echo "📄 Читаем exclude: $file"

  local raw
  while IFS= read -r raw || [ -n "$raw" ]; do
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    [[ -z "$raw" ]] && continue
    [[ "$raw" == \#* ]] && continue
    add_task "LINK" "exclude" "$raw"
  done < "$file"
}

parse_config_file "$CONFIG_FILE"
parse_exclude_file "$EXCLUDE_FILE"

echo "⚙️  Настройка окружения..."

for TASK in "${TASKS[@]}"; do
  ACTION="${TASK%%$'\t'*}"
  REST="${TASK#*$'\t'}"
  TASK_SOURCE="${REST%%$'\t'*}"
  ITEM="${REST#*$'\t'}"

  if [ "$ACTION" = "RUN" ]; then
    echo "🚀 RUN: $ITEM"
    eval "$ITEM"
    continue
  fi

  if [[ "$ITEM" == *"*"* ]] || [[ "$ITEM" == *"?"* ]] || [[ "$ITEM" == *"["* ]]; then
    echo "⚪️ Пропущено: $ITEM (glob-паттерны не поддерживаются)"
    continue
  fi

  SRC="$MAIN_WORKTREE/$ITEM"
  TGT="./$ITEM"

  if [ ! -e "$SRC" ] && [ ! -L "$SRC" ]; then
    continue
  fi

  if [ -e "$TGT" ] || [ -L "$TGT" ]; then
    if [ -L "$TGT" ]; then
      # Existing symlink — safe to replace under any verb.
      rm "$TGT"
    elif [ "$TASK_SOURCE" = "config" ] \
         && git ls-files --error-unmatch -- "$ITEM" >/dev/null 2>&1 \
         && [ -z "$(git status --porcelain -- "$ITEM" 2>/dev/null)" ]; then
      # Tracked & clean file that the user explicitly listed in config.
      # Safe to replace — the contents live in git.
      rm -rf "$TGT"
    else
      echo "⚠️  Пропущено: $ITEM (существует локальный файл, не перезаписываю)"
      continue
    fi
  fi

  TGT_PARENT=$(dirname "$TGT")
  if [ ! -d "$TGT_PARENT" ]; then
    mkdir -p "$TGT_PARENT"
  fi

  if [ "$ACTION" = "COPY" ]; then
    cp -R "$SRC" "$TGT"
    echo "📋 COPY: $ITEM"
  elif [ "$ACTION" = "LINK" ]; then
    ln -sfn "$SRC" "$TGT"
    echo "🔗 LINK: $ITEM"
  else
    echo "❓ Неизвестное действие: $ACTION для $ITEM"
  fi
done

echo "🎉 Готово!"
